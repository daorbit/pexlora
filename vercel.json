{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "regions": [
    "bom1"
  ],
  "functions": {
    "src/app/api/images/**/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/files/**/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
